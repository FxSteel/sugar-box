# Copiar a .env.local para desarrollo. En producción se configuran en Dokploy.

# Build-time (se usan al prerenderizar: pasarlas como build args en Dokploy)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP=          # formato internacional, solo dígitos (ej. 5215512345678)
NEXT_PUBLIC_GA_ID=
APP_ENV=development            # production habilita indexación en Google
GOOGLE_SITE_VERIFICATION=

# Runtime (solo servidor)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
DATABASE_URL=                  # postgres://user:pass@host:5432/sugarbox
